generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  DRIVER
  WAREHOUSE
  SUPER_ADMIN
}

enum ShipmentStatus {
  DRAFT
  PENDING
  PICKUP_ASSIGNED
  PICKED_UP
  RECEIVED_AT_WAREHOUSE
  PROCESSING
  READY_FOR_DISPATCH
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  SHIPMENT_DRIVER
}

enum OtpStatus {
  ACTIVE
  USED
  EXPIRED
}

model User {
  id               String    @id @default(uuid())
  firstName        String
  lastName         String
  email            String    @unique
  phone            String    @unique
  passwordHash     String
  role             UserRole  @default(USER)
  emailVerified    Boolean   @default(false)
  emailVerifiedAt  DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  shipments        Shipment[]
  otps             Otp[]
  assignedDriverShipments Shipment[] @relation("DriverShipments")
  warehouseShipments      Shipment[] @relation("WarehouseShipments")
}

model Shipment {
  id                 String         @id @default(uuid())
  userId             String
  pickupAddress      String
  pickupCity         String
  pickupState        String
  pickupContactName  String
  pickupPhone        String
  deliveryAddress    String
  deliveryCity       String
  deliveryState      String
  recipientName      String
  recipientPhone     String
  packageType        String
  description        String
  estimatedWeight    Float
  weightUnit         String
  length             Float?
  width              Float?
  height             Float?
  dimensionUnit      String?
  isFragile          Boolean
  declaredValue      Float?
  status             ShipmentStatus  @default(PENDING)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id])
  assignedDriverId   String?
  warehouseId        String?
  assignedAt         DateTime?
  pickedUpAt         DateTime?
  receivedAt         DateTime?
  processingStartedAt DateTime?
  readyForDispatchAt DateTime?
  assignedDriver     User?          @relation("DriverShipments", fields: [assignedDriverId], references: [id])
  warehouse          User?          @relation("WarehouseShipments", fields: [warehouseId], references: [id])
  otp                Otp?

  @@index([status])
  @@index([assignedDriverId, status])
  @@index([warehouseId, status])
}

model Otp {
  id        String     @id @default(uuid())
  userId    String
  shipmentId String?   @unique
  code      String
  purpose   OtpPurpose
  status    OtpStatus  @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  shipment Shipment? @relation(fields: [shipmentId], references: [id])

  @@index([userId, purpose])
}
