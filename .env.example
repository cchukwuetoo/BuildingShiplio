# --- App ---
NODE_ENV=development
PORT=3000

# --- Database ---
# Format depends on what you pick (Postgres shown here)
DATABASE_URL=postgresql://postgres:password@localhost:5432/shiplio

# --- Auth (JWT) ---
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- Courier provider APIs (comparison step) ---
GIG_LOGISTICS_API_KEY=
GIG_LOGISTICS_BASE_URL=
SENDQUICK_API_KEY=
SENDQUICK_BASE_URL=

# --- OTP delivery (driver handoff verification) ---
# Fill in whichever provider you end up using to send the OTP to the user
OTP_EXPIRES_IN_MINUTES=10