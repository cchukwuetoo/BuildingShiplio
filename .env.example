# --- App ---
NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/shiplio

# --- Auth (JWT) ---
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=change-this-refresh-secret
REFRESH_TOKEN_EXPIRES_IN_MINUTES=10080

# --- OTP ---
OTP_EXPIRES_IN_MINUTES=10

# --- Brevo email delivery ---
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@shiplio.com
BREVO_SENDER_NAME=ShipLio
